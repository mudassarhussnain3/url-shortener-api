{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "<set-via-user-secrets-or-env>"
  },
  "Jwt": {
    "Key": "<set-via-user-secrets-or-env-min-32-chars>",
